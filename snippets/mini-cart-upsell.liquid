    <style>

    .swiper {
      width: 500px;
      height: 100%;
    }

    .swiper-slide {
      text-align: center;
      font-size: 18px;
      {% comment %} background: #444; {% endcomment %}
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
     .upsell_item {
            display: flex;
            gap: 10px;
        }
        .cart_up_content {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .upsell_product_image img {
            width: 100px;
        }
  </style>
  
  <div class="swiper mySwiper">
    <div class="swiper-wrapper">
        {% for item in cart.items %}
            {% assign item_conatins = false %}
            {{ item.handle }}
        {% endfor %}
      {% for product in settings.cart_upsell_product %}

        <div class="swiper-slide">
                <div class="upsell_item">
                    <div class="upsell_product_image">
                        <img src="{{ product.featured_image | img_url:'master' }}" alt="">
                    </div>
                    <div class="cart_up_content">
                        <div class="cart_up_title">
                            <h5>{{ product.title }}</h5>
                        </div>
                        <div class="cart_up_btn">

                        </div>
                    </div>
                </div>
        </div>
      {% endfor %}
    </div>
    <div class="swiper-button-next"></div>
    <div class="swiper-button-prev"></div>
  </div>

  <!-- Initialize Swiper -->
  <script>
    var swiper = new Swiper(".mySwiper", {
      navigation: {
        nextEl: ".swiper-button-next",
        prevEl: ".swiper-button-prev",
      },
    });
  </script>