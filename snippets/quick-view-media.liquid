

{%- case media.media_type -%}    
  {% when 'image' %}
    <a href="#">
      <img data-cke-saved-src="{{ media | img_url: 'master'}}" src="{{ media | img_url: 'master'}}" alt="{{ media.alt }}">
    </a>
  {%- when 'video' -%}
    <a href="#">
      {{ media | media_tag: image_size: "2048x", autoplay: true, loop: loop, controls: true, preload: "none" }}
    </a>
  {%- when 'external_video' -%}
    {%- if media.host == 'youtube' -%}
      <a href="#">
        {{ media | external_video_url: autoplay: true, loop: loop, playlist: media.external_id | external_video_tag: class: video_class, loading: "lazy", alt: "green" }}
      </a>
    {%- else -%}
      <a href="#">
        {{ media | external_video_url: autoplay: true, loop: loop | external_video_tag: class: video_class, loading: "lazy", alt: "green" }}
      </a> 
    {%- endif -%}
  {%- when 'model' -%}
  <a href="#">
    {{ media | media_tag: image_size: "2048x", toggleable: true }}
    </a> 
{%- endcase -%}
