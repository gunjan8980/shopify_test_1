    </div>
  </div>
</section>

<script>
var letest_blog_slider = new Swiper(".letest_blog_slider", {
    slidesPerView: 1.12,
    spaceBetween: 8,
    freeMode: true,
    breakpoints: {
        476: {
          slidesPerView: 1.4,
          spaceBetween: 24,
        },
        991: {
          slidesPerView: 2,
          spaceBetween: 24,
        }
      }
  });
</script>



