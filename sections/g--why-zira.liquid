
    
    <div class="why_zira">
        {% if section.settings.heading != blank %}
            <div class="wz_top_content">
                <h3>{{ section.settings.heading }}</h3>
            </div>
        {% endif %}
        <div class="wz_bottom_content">
            {% for block in section.blocks %}
                <div class="wz_card">
                    {% if block.settings.show_image %}
                        {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | img_url: 'master'}}" alt="{{ block.settings.image.alt }}">
                        {% endif %}
                    {% else %}
                        {% capture wz_text_content %}{{ block.settings.top_text }}{{ block.settings.bottom_text }}{% endcapture %}
                        {% if wz_text_content != blank %}
                            <div class="wz_text_content">
                                {% if block.settings.top_text != blank %}
                                    <div class="wz_description">
                                        <p>{{ block.settings.top_text }}</p>
                                    </div>
                                {% endif %}
                                {% if block.settings.bottom_text != blank %}
                                    <div class="wz_note">
                                        <p>{{ block.settings.bottom_text }}</p>
                                    </div>
                                {% endif %}
                            </div>
                        {% endif %}
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>


{% schema %}
  {
    "name": "Why zira",
    "settings": [
      {
        "type":"text",
        "id":"heading",
        "label":"Heading"
      }
    ],
    "blocks": [
      {
        "type": "block",
        "name": "block",
        "settings": [
          {
            "type":"checkbox",
            "id":"show_image",
            "label":"Show Image"
          },
          {
            "type":"image_picker",
            "id":"image",
            "label":"Image"
          },
          {
            "type":"text",
            "id":"top_text",
            "label":"Text 1"
          },
          {
            "type":"text",
            "id":"bottom_text",
            "label":"Text 2"
          }
        ]
      }
    ],

    "presets": [
      {
        "name": "Why zira"
      }
    ]
  }
{% endschema %}
