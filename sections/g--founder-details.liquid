
<div class="founder_details">
    {% if section.settings.image != blank %}
        <div class="founder_details_img">
            <img src="{{ section.settings.image | image_url }}" alt="{{ section.settings.image.alt }}">
        </div>
    {% endif %}
    <div class="fd_content">
        {% if section.settings.heading != blank %}
            <div class="fd_title">
                <h3>{{ section.settings.heading }}</h3>
            </div>
        {% endif %}
        {% if section.settings.content != blank %}
            <div class="fd_content">
                {{ section.settings.content }}
            </div>
        {% endif %}
        {% if section.settings.tag_line != blank %}
            <div class="fd_tagline">
                <p>{{ section.settings.tag_line }}</p>
            </div>
        {% endif %}
        {% if section.settings.name != blank %}
            <div class="fd_name">
                <p>{{ section.settings.name }}</p>
            </div> 
        {% endif %}
    </div>
</div>

{% schema %}
  {
    "name": "Founder details",
    "settings": [
        {
            "type":"image_picker",
            "id":"image",
            "label":"Image"
        },
        {
            "type":"text",
            "id":"heading",
            "label":"Heading"
        },
        {
            "type":"richtext",
            "id":"content",
            "label":"Content"
        },
        {
            "type":"text",
            "id":"tag_line",
            "label":"Tag line"
        },
        {
            "type":"text",
            "id":"name",
            "label":"Name"
        }

    ],
    "presets": [
      {
        "name": "Founder details"
      }
    ]
  }
{% endschema %}
