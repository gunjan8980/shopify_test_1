<div
  class="wall_section"
  style="background-image: url(https://cdn.shopify.com/s/files/1/0675/6820/5912/files/Group_1484582299.png?v=1760549848)"
>
  <div class="wall_main_wpr">
    <div class="wall_wpr">
      <div class="wall_container">
        <div class="wall_content">
          {% assign cols = 'frist_col,second_col,third_col,fourth_col' | split: ',' %}
          {% for col in cols %}
            {% assign col_blocks = section.blocks | where: 'type', col %}
            {% assign side_class = 'up-side' %}
            {% if forloop.index0 == 1 or forloop.index0 == 3 %}
              {% assign side_class = 'down-side' %}
            {% endif %}
            <div class="wall_col">
              <div class="wall_slider swiper {{ side_class }}">
                <div class="swiper-wrapper">
                  {% for block in col_blocks %}
                    <div class="swiper-slide">
                      <div class="wall_main {{ block.settings.color_class }}">
                        <div class="wall_block">
                          <div class="wall_block_top">
                            {% if block.settings.date != blank %} {{ block.settings.date }} {% endif %}
                            <span class="wall_block_dots">
                              <img src="https://cdn.shopify.com/s/files/1/0675/6820/5912/files/ellipsis.svg?v=1760550921">
                            </span>
                          </div>
                          {% if block.settings.block_content != blank %}
                            <div class="wall_block_center">
                              <h5>{{ block.settings.block_content }}</h5>
                            </div>
                          {% endif %}
                          {% if block.settings.bottom_text != blank %}
                            <div class="wall_block_bottom">
                              <span>{{ block.settings.bottom_text }}</span>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                  {% for block in col_blocks %}
                    <div class="swiper-slide">
                      <div class="wall_main {{ block.settings.color_class }}">
                        <div class="wall_block">
                          <div class="wall_block_top">
                            {% if block.settings.date != blank %} {{ block.settings.date }} {% endif %}
                            <span class="wall_block_dots">
                              <img src="https://cdn.shopify.com/s/files/1/0675/6820/5912/files/ellipsis.svg?v=1760550921">
                            </span>
                          </div>
                          {% if block.settings.block_content != blank %}
                            <div class="wall_block_center">
                              <h5>{{ block.settings.block_content }}</h5>
                            </div>
                          {% endif %}
                          {% if block.settings.bottom_text != blank %}
                            <div class="wall_block_bottom">
                              <span>{{ block.settings.bottom_text }}</span>
                            </div>
                          {% endif %}
                        </div>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
    {% capture wall_popup %}
      {{ section.settings.heading }}{{ section.settings.sub_head }}{{ section.settings.sub_head_italic }}{{ section.settings.image }}
    {% endcapture %}
    {% if wall_popup != blank %}
      <div class="wall_popup">
        <div class="wall_popup_inner">
          {% if section.settings.heading != blank %}
            <h6>{{ section.settings.heading }}</h6>
          {% endif %}

          <h2>
            {{ section.settings.sub_head }}
            <i>{{ section.settings.sub_head_italic }}</i>
          </h2>
          {% if section.settings.content != blank %} {{ section.settings.content }}{% endif %}

          {% if section.settings.image != blank %}
            <div class="wall_popup_img">
              <img src="{{ section.settings.image | img_url: 'master'}}" alt="{{ section.settings.image.alt }}">
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<style>
    .wall_main_wpr {
        position: relative;
    }
    .wall_wpr {
        pointer-events: none;
        user-select: none;
    }
    .wall_popup_inner>h6 {
      color: #56516B;
      font-family: Sohne, sans-serif !important;
      font-weight: 500;
      font-size: 14px;
      line-height: 24px;
      letter-spacing: 0.56px;
      text-align: center;
      text-transform: uppercase;
      margin: 0 0 8px;
  }
  .wall_container .swiper-wrapper {
      transition-timing-function: linear;
      box-sizing: border-box;
  }
  .wall_popup_inner>h2 {
      color: #56516B;
      font-family: Sohne, sans-serif !important;
      font-weight: 300;
      font-size: 28px;
      line-height: 30px;
      letter-spacing: 0;
      text-align: center;
      margin: 0 0 20px;
  }
  .wall_popup_inner>h2 i {
      display: block;
      font-family: Test Signifier;
      font-weight: 300;
      font-style: italic;
      font-size: 34px;
      line-height: 36px;
      letter-spacing: -0.68px;
      text-align: center;
  }
  .wall_popup_inner>p {
      color: #56516B;
      font-family: Sohne, sans-serif !important;
      font-weight: 300;
      font-size: 16px;
      line-height: 26px;
      letter-spacing: 0;
      text-align: center;
      margin: 0;
  }
  .wall_popup_img img {
      max-width: 144px;
      width: 100%;
      display: block;
      margin: 0 auto;
  }
  .wall_popup_img {
      margin: 20px 0 0;
  }
  .wall_popup_inner {
      max-width: 378px;
      margin: 0 auto;
  }
  .wall_popup {
      border: 1px solid #FFFFFF;
      background: #FFFFFF1A;
      border-radius: 30px;
      padding: 48px 44px;
      width: 466px;
      margin: 0 auto;
      backdrop-filter: blur(60px);
      box-shadow: 0px 4px 77px 0px #56516B33;
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50% , -50%);
      z-index: 2;
  }
  .wall_section {
      padding: 218px 0 137px;
      background-repeat: no-repeat;
      background-size: cover;
      background-position: center;
  }
  .wall_container {
      width: 100%;
      max-width: 1500px;
      padding: 0 30px;
      margin: 0 auto;
  }
  .wall_block_top p {
      color: #77598E;
      font-family: 'Satoshi';
      font-weight: 400;
      font-size: 12px;
      line-height: 1.5;
      letter-spacing: 0;
      margin: 0;
  }
  .wall_block_dots {
      width: 23px;
      height: 23px;
      display: flex;
      align-items: center;
      padding: 5px;
      justify-content: center;
  }
  .wall_block_top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
  }
  .wall_block_center h5 {
      color: #77598E;
      font-family: 'Satoshi';
      font-weight: 400;
      font-size: 16px;
      line-height: 1.5;
      letter-spacing: 0;
      margin: 0;
  }
  .wall_block_bottom span {
      color: #77598E;
      font-family: 'Satoshi';
      font-weight: 400;
      font-size: 14px;
      line-height: 1.5;
      letter-spacing: 0;
      display: inline-block;
      padding: 2px 10px;
      background: #77598E33;
      border-radius: 99px;
      backdrop-filter: blur(51px);
  }
  .wall_block {
      display: flex;
      flex-direction: column;
      gap: 10px;
  }
  .wall_block_bottom {
      text-align: end;
  }
  .wall_main {
      width: 100%;
      max-width: 345px;
      border-radius: 15px;
      background: #FFFFFF33;
      border: 1px solid #FFFFFF;
      backdrop-filter: blur(51px);
      padding: 15px;
  }
  .blue_shadow {
      box-shadow: 0px 4px 27px 0px #88F5F7;
  }
  .orange_shadow {
      box-shadow: 0px 4px 27px 0px #FFB899;
  }
  .green_shadow {
      box-shadow: 0px 4px 27px 0px #BDFCC9;
  }
  .yellow_shadow {
      box-shadow: 0px 4px 27px 0px #FBE7A1;
  }
  .purple_shadow {
      box-shadow: 0px 4px 27px 0px #9B8CFF;
  }
  .grey_shadow {
      box-shadow: 0px 4px 27px 0px #BFC7C8;
  }
  .pink_shadow {
      box-shadow: 0px 4px 27px 0px #F9C2D5;
  }
  .wall_slider {
      height: 725px;
      padding: 10px;
  }
  .wall_slider .swiper-slide {
      height: fit-content;
  }
  .wall_content {
    display: flex;
    -webkit-mask-image: url(https://cdn.shopify.com/s/files/1/0675/6820/5912/files/Layer_Blur.svg?v=1762019454);
    mask-image: url(https://cdn.shopify.com/s/files/1/0675/6820/5912/files/Layer_Blur.svg?v=1762019454);
    mask-repeat: no-repeat;
    mask-size: cover;
    -webkit-mask-position-x: center;
  }
  .wall_col {
      width: 25%;
  }
  @media only screen and (max-width: 991px) {
    .wall_col {
        width: 100%;
    }
    .wall_content {
        flex-wrap: wrap;
    }
    .wall_slider {
        height: auto;
        padding: 12px;
    }
    .wall_container {
        padding: 0;
    }
    .wall_slider .swiper-slide {
      flex: 0 0 auto;
      width: auto !important;
  }
   .wall_section {
      padding: 170px 0 92px;
      background-image: url(https://cdn.shopify.com/s/files/1/0675/6820/5912/files/Group_1484582301_1.png?v=1760640974) !important;
  }
  }
  @media only screen and (max-width: 767px) {
    .wall_block_center h5 {
      font-size: 14px;
  }
  .wall_main {
      max-width: 246px;
  }
  }
  @media only screen and (max-width: 525px) {
    .wall_popup {
        width: calc(100% - 60px);
        padding: 40px 20px;
        border-radius: 20px;
    }
    .wall_popup_inner>h6 {
        font-size: 12px;
        line-height: 20px;
        letter-spacing: 0.48px;
        margin: 0 0 12px;
    }
    .wall_popup_inner>h2 {
        font-size: 20px;
        line-height: 24px;
        margin: 0 0 16px;
    }
    .wall_popup_inner>h2 i {
      font-size: 26px;
      line-height: 28px;
      letter-spacing: -0.26px;
  }
    .wall_popup_inner>p {
      font-size: 14px;
      line-height: 22px;
  }
  .wall_popup_inner {
      max-width: 278px;
      margin: 0 auto;
  }
    .wall_section {
      padding: 124px 0 62px;
  }
  }
</style>

<script>
  var wall_slider_up = new Swiper('.wall_slider.up-side', {
    direction: "horizontal",
    slidesPerView: 'auto',
    spaceBetween: 12,
    loop: true,
    freeMode: true,
    autoplay: {
      delay: 0,
      disableOnInteraction: false,
    },
    speed: 5000,
    allowTouchMove: !1,
    breakpoints: {
      992: {
        direction: 'vertical',
        spaceBetween: 20,
      },
    },
  });
  var wall_slider_down = new Swiper('.wall_slider.down-side', {
    direction: "horizontal",
    slidesPerView: 'auto',
    spaceBetween: 12,
    loop: true,
    freeMode: true,
     autoplay: {
      delay: 0,
      disableOnInteraction: false,
      reverseDirection: !0,
    },
    speed: 5000,
    allowTouchMove: !1,
    breakpoints: {
      992: {
        direction: 'vertical',
        spaceBetween: 20,
      },
    },
  });
</script>

