<div class="personalize_popup_overlay"></div>
<div class="personalize_popup">
  <div class="personalize_inner">
    <div class="personalize_close">
      <a href="#">
        <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
        <path d="M8.7492 8.75L0.75 0.75M0.750853 8.75L8.75 0.75" stroke="#263A99" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      </a>
    </div>
    <div class="personalize_wpr">
      <div class="personalize_img">
        <img src="https://cdn.shopify.com/s/files/1/0405/6196/7266/files/HAR00627_1.png?v=1763319017">
      </div>
      <div class="personalize_info">
        <div class="personalize_info_title">
          <h2>MY DAILY ROUTINE</h2>
          <p>Undated Daily Planner</p>
        </div>
        <div class="personalize_info_price">
          <span class="main_price">₹1450</span>
          <span class="compare_price">₹1667</span>
          <div class="disc_per">
            <span>25% Off</span>
          </div>
        </div>
        <div class="personalize_bottom">
          <form>
            <div class="personalize_name_field">
              <label>Name</label>
              <input type="name" placeholder="Enter Name">
            </div>
            <div class="personalize_field">
              <span>Choose font</span>
              <div class="name-style-selector">
                  <label class="personalize_option font_1">
                      <input type="radio" name="namestyle" value="style1" checked>
                      <div class="preview">Your Name</div>
                  </label>
                  <label class="personalize_option font_2">
                      <input type="radio" name="namestyle" value="style2">
                      <div class="preview script1">Your Name</div>
                  </label>
                  <label class="personalize_option font_3">
                      <input type="radio" name="namestyle" value="style3">
                      <div class="preview script2">your name</div>
                  </label>
              </div>
            </div>
            <button>ADD TO CART</button>
            <p>*personalized orders are made to order & are prepaid only</p>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>


{% schema %}
{
  "name": "Personalize product",
  "settings": [
  ],
  "presets": [
    {
      "name": "Personalize product",
    }
  ]
}
{% endschema %}
